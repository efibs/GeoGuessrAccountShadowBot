<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Discord">
        <PackageVersion Include="Discord.Net" Version="3.20.2"/>
    </ItemGroup>

    <ItemGroup Label="Hosting and configuration">
        <PackageVersion Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14"/>
    </ItemGroup>

    <ItemGroup Label="HTTP">
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0"/>
        <PackageVersion Include="Polly.RateLimiting" Version="8.9.0"/>
        <PackageVersion Include="Refit" Version="16.4.0"/>
    </ItemGroup>

    <ItemGroup Label="Persistence">
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14"/>
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0"/>
        <PackageVersion Include="coverlet.collector" Version="10.1.0"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2"/>
        <PackageVersion Include="NSubstitute" Version="6.2.0"/>
        <PackageVersion Include="Verify.Xunit" Version="31.12.5"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>

</Project>
